{
  // JSONC (non TOML): permette i commenti, e il resto del progetto già "dice
  // il perché" nei commenti — coerenza con come si scrive qui, non solo con
  // Cloudflare. Wrangler legge entrambi i formati allo stesso modo.

  // Il nome del progetto su Cloudflare (sistema unificato Workers & Pages).
  // Va creato a mano nel pannello prima del primo deploy: questo file
  // descrive la build, non lo crea da solo — vedi
  // docs/2026-08-27-deploy-zack-app.md.
  "name": "zack-app",

  // Richiesta da Wrangler per fissare il comportamento della piattaforma
  // nel tempo. Impostata alla data di stesura di questa configurazione.
  "compatibility_date": "2026-08-27",

  /**
   * `pages_build_output_dir` è capita SOLO da `wrangler pages deploy`.
   *
   * Il progetto creato sul pannello Cloudflare è del tipo unificato
   * "Workers & Pages", e il suo comando di pubblicazione è `wrangler deploy`
   * — non `wrangler pages deploy`. Quel comando legge `assets.directory`, non
   * `pages_build_output_dir`: con la chiave sbagliata, la fase "Deploying"
   * falliva dicendo "you can either specify --assets=./dist or add assets to
   * wrangler.jsonc" (misurato il 2026-08-27, build #2b133587). Nessuno
   * "script" Worker qui: è un sito di soli file statici, e senza `main`
   * Wrangler lo pubblica come Worker-di-soli-asset, che è esattamente cosa
   * serve.
   */
  /*
   * Da qui il Worker ha del CODICE, non solo file.
   *
   * `assets.directory` resta: le richieste che combaciano con un file statico
   * lo servono come prima, e solo le altre arrivano a `worker/index.js`. Il
   * sito continua a funzionare identico; cambia che `/me` ora esiste.
   */
  "main": "worker/index.js",

  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },

  /**
   * Il dominio vero, dichiarato qui e non fatto a mano dal pannello.
   *
   * `custom_domain: true` dice a Cloudflare di occuparsi lui di certificato
   * e DNS — la stessa cosa che farebbe il pulsante "Connect Domain" nella UI,
   * ma tracciata nel repository invece che persa in un clic. Senza questo il
   * Worker resta pubblicato ma irraggiungibile: "No URLs enabled" nel
   * pannello, zero domini collegati (misurato il 2026-08-27, versione
   * cf0048bc — la build passava, il sito non rispondeva da nessun indirizzo).
   */
  "routes": [
    { "pattern": "zack-app.com", "custom_domain": true },
    { "pattern": "www.zack-app.com", "custom_domain": true }
  ],

  /*
   * Una volta all'ora, al minuto zero. I lavori rimasti a meta' si rimborsano
   * da soli: senza questo, un Worker morto fra l'addebito e l'esito lascia il
   * cliente pagato e senza niente, e non se ne accorge nessuno.
   */
  "triggers": { "crons": ["0 * * * *"] }
}
