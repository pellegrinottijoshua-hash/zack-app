{
  // JSONC (non TOML): permette i commenti, e il resto del progetto già "dice
  // il perché" nei commenti — coerenza con come si scrive qui, non solo con
  // Cloudflare. Wrangler legge entrambi i formati allo stesso modo.

  // Il nome del progetto Pages su Cloudflare. Va creato a mano nel pannello
  // (o con `wrangler pages project create zack-app`) prima del primo deploy:
  // questo file descrive la build, non la crea da solo — vedi
  // docs/2026-08-27-deploy-zack-app.md.
  "name": "zack-app",

  // Richiesta da Wrangler per fissare il comportamento della piattaforma
  // nel tempo. Impostata alla data di stesura di questa configurazione.
  "compatibility_date": "2026-08-27",

  // La cartella che `vite build` produce e che Pages deve pubblicare.
  "pages_build_output_dir": "dist"
}
